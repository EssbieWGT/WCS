# Load libraries
library(dplyr)
library(lubridate)
# --- CONFIGURATION ---
# Change these values to update the filter range
start_date <- "2026-04-16"
end_date   <- "2026-04-30"
file_path  <- "C:/Users/wesle/Desktop/Coding Projects/wcs/masterdata/tricare.csv"
# ---------------------
# 1. Load the data
df <- read.csv(file_path)
# 2. Convert 'published' to date-time
df$published <- ymd_hms(df$published)
# 3. Create actual POSIXct boundary objects
# We use floor_date and ceiling_date logic to ensure we catch
# the very beginning of the start and the very end of the end.
start_boundary <- as.POSIXct(start_date)
end_boundary   <- as.POSIXct(paste(end_date, "23:59:59"))
# 4. Filter the dataframe
filtered_df <- df %>%
filter(published >= start_boundary & published <= end_boundary)
# Output results
print(paste("Rows before filter:", nrow(df)))
print(paste("Rows after filter:", nrow(filtered_df)))
write.csv(filtered_df, "tricare_sentiment.csv")
