setwd("C:/Users/wesle/Desktop/Coding Projects/wcs")
#script to get EDF total for the year
setwd("C:/Users/wesle/Desktop/Coding Projects/wcs")
# Date range (inclusive)
start_date <- as.Date("2025-10-01")
end_date   <- as.Date("2026-09-10")
# Read files
saf      <- read.csv("./harvested/saf.csv", stringsAsFactors = FALSE)
shipping <- read.csv("./harvested/shipping.csv", stringsAsFactors = FALSE)
# Count unique stories published within the date range.
# Uses URL as the unique identifier when available; otherwise uses headline/title.
count_unique_stories <- function(data) {
# Handles dates and timestamps beginning with YYYY-MM-DD
data$published_date <- as.Date(substr(data$published, 1, 10))
filtered <- data[
!is.na(data$published_date) &
data$published_date >= start_date &
data$published_date <= end_date,
]
if ("url" %in% names(filtered)) {
story_id <- filtered$url
} else if ("link" %in% names(filtered)) {
story_id <- filtered$link
} else if ("headline" %in% names(filtered)) {
story_id <- filtered$headline
} else if ("title" %in% names(filtered)) {
story_id <- filtered$title
} else {
# If no identifying column is available, count unique complete rows
return(nrow(unique(filtered)))
}
story_id <- trimws(story_id)
story_id <- story_id[!is.na(story_id) & story_id != ""]
length(unique(story_id))
}
saf_story_count      <- count_unique_stories(saf)
shipping_story_count <- count_unique_stories(shipping)
total_story_count    <- saf_story_count + shipping_story_count
# Count business days, including both the start and end dates.
# This excludes Saturdays and Sundays but does not exclude holidays.
all_dates <- seq(start_date, end_date, by = "day")
business_days <- sum(as.POSIXlt(all_dates)$wday %in% 1:5)
# Calculate monitoring values
saf_value      <- business_days * 90
shipping_value <- business_days * 68
total_value    <- saf_value + shipping_value
# Display results
results <- data.frame(
Category = c("SAF", "SHIPPING", "TOTAL"),
Unique_Stories = c(
saf_story_count,
shipping_story_count,
total_story_count
),
Business_Days = c(
business_days,
business_days,
business_days
),
Calculated_Value = c(
saf_value,
shipping_value,
total_value
)
)
print(results)
39026/16000
View(saf)
