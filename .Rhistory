file_path <- "C:\Users\wesle\Desktop\Coding Projects\wcs\development\scraped_bytes.txt"  # <-- update this
# ---- Load libraries ----
library(tidyverse)
library(lubridate)
# ---- File path ----
file_path <- "C:/Users/wesle/Desktop/Coding Projects/wcs/development/scraped_bytes.txt"
# ---- Read + parse log ----
df <- read_lines(file_path) %>%
tibble(raw = .) %>%
extract(
raw,
into = c("timestamp", "articles", "bytes", "search"),
regex = "^(.*?) \\| Articles: (\\d+) \\| Total Bytes: (\\d+) \\| Search: (.*)$"
) %>%
mutate(
timestamp = ymd_hms(timestamp),
date = as_date(timestamp),
articles = as.integer(articles),
bytes = as.numeric(bytes)
)
# ---- Aggregate to daily totals ----
daily <- df %>%
group_by(date) %>%
summarise(
total_articles = sum(articles, na.rm = TRUE),
total_bytes = sum(bytes, na.rm = TRUE),
.groups = "drop"
)
# ---- Aggregate by search term ----
daily_by_search <- df %>%
group_by(date, search) %>%
summarise(
total_articles = sum(articles, na.rm = TRUE),
total_bytes = sum(bytes, na.rm = TRUE),
.groups = "drop"
)
# ---- Plot 1: Articles per day ----
p1 <- ggplot(daily, aes(x = date, y = total_articles)) +
geom_line() +
geom_point() +
labs(
title = "Articles per Day",
x = "Date",
y = "Total Articles"
) +
theme_minimal()
print(p1)
# ---- Plot 2: Bytes per day (in MB for readability) ----
p2 <- ggplot(daily, aes(x = date, y = total_bytes / 1e6)) +
geom_line() +
geom_point() +
labs(
title = "Total Data Volume per Day",
x = "Date",
y = "MB"
) +
theme_minimal()
print(p2)
# ---- Plot 3: Articles per day by search term ----
p3 <- ggplot(daily_by_search, aes(x = date, y = total_articles, color = search)) +
geom_line() +
labs(
title = "Articles per Day by Search Term",
x = "Date",
y = "Total Articles",
color = "Search Term"
) +
theme_minimal()
print(p3)
View(daily)
mean(daily$total_bytes)
hist(daily$total_bytes)
summary(daily$total_bytes)
212300174/3
summary(daily$total_articles)
tricare = daily_by_search %>% filter(., search == "TRICARE")
View(tricare)
tricare = daily_by_search %>% filter(., search == "TRICARE")
p4 <- ggplot(tricare, aes(x = date, y = total_articles, color = search)) +
geom_line() +
labs(
title = "TRICARE Articles per Day",
x = "Date",
y = "Total Articles",
color = "Search Term"
) +
theme_minimal()
